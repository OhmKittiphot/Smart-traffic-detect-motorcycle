# Environment files
.env
.env.*

# Python cache/compiled files
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
venv/

# Editor settings
.vscode/
.idea/

# Build and packaging artifacts
build/
dist/
*.egg-info/

# Logs and temporary files
*.log
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db


# Datasets (download from Roboflow) and their archives
*-dataset/
*.zip

# Training and evaluation scripts
train.py
eval.py

# Data directories
output/
input/

# Large local model weights
models/

# Training runs: keep only the weights the app loads
runs/*
!runs/detect/
runs/detect/*
!runs/detect/moto-plate/
!runs/detect/helmet-rider/
runs/detect/moto-plate/*
runs/detect/helmet-rider/*
!runs/detect/moto-plate/weights/
!runs/detect/helmet-rider/weights/
runs/detect/*/weights/*
!runs/detect/*/weights/best.pt
yolo26n.pt

# Web dashboard runtime data (database, generated secret key, evidence snapshots)
web/db.sqlite3
web/.secret_key
web/media/
web/staticfiles/
